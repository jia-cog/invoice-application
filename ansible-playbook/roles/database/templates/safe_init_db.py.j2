#!/usr/bin/env python3
"""
Safe database initialization script for the Invoice Application.
Managed by Ansible - DO NOT EDIT MANUALLY.

IMPORTANT: Unlike the original init_db.py, this script does NOT call db.drop_all().
It only creates tables if they do not already exist, preventing data loss on redeployments.
"""

import os
import sys

# Ensure the backend directory is in the Python path
sys.path.insert(0, '{{ backend_dir }}')

from app import create_app
from models import db

def safe_init_database():
    """Initialize the database safely - creates tables only if they don't exist."""
    app = create_app()

    with app.app_context():
        # db.create_all() is safe: it only creates tables that don't exist yet.
        # It will NOT drop or modify existing tables and data.
        db.create_all()

        print("Database initialization completed safely!")
        print("Tables ensured (created only if missing):")
        print("- users")
        print("- invoices")
        print("- invoice_items")
        print("- reports")

if __name__ == '__main__':
    safe_init_database()
