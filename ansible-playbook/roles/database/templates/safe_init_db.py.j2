#!/usr/bin/env python3
"""
Safe database initialization script for the Invoice Application.
This script creates tables WITHOUT dropping existing ones, preventing data loss
on redeployments. It only creates tables that do not already exist.

Managed by Ansible - Do not edit manually.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(__file__))

from app import create_app
from models import db

def safe_init_database():
    """Initialize the database safely - only create tables if they don't exist."""
    app = create_app()

    with app.app_context():
        # db.create_all() only creates tables that don't already exist.
        # Unlike init_db.py, we deliberately do NOT call db.drop_all().
        db.create_all()

        print("Database initialized safely!")
        print("Tables verified/created:")
        print("- users")
        print("- invoices")
        print("- invoice_items")
        print("- reports")

if __name__ == '__main__':
    safe_init_database()
