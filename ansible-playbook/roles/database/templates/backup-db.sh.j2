#!/usr/bin/env bash
# Invoice Application - Database Backup Script
# Managed by Ansible - DO NOT EDIT MANUALLY
#
# Creates a timestamped SQLite backup in {{ app_base_dir }}/backups/
# Retains the last 30 backups.

set -euo pipefail

BACKUP_DIR="{{ app_base_dir }}/backups"
DB_FILE="{{ database_file }}"
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
BACKUP_FILE="${BACKUP_DIR}/invoice_app_${TIMESTAMP}.db"
RETENTION_COUNT=30

# Ensure backup directory exists
mkdir -p "${BACKUP_DIR}"

# Create backup using SQLite online backup API
if [ -f "${DB_FILE}" ]; then
    sqlite3 "${DB_FILE}" ".backup '${BACKUP_FILE}'"
    echo "Backup created: ${BACKUP_FILE}"
else
    echo "WARNING: Database file not found at ${DB_FILE}"
    exit 1
fi

# Remove old backups beyond retention count
cd "${BACKUP_DIR}"
ls -1t invoice_app_*.db 2>/dev/null | tail -n +$((RETENTION_COUNT + 1)) | xargs -r rm -f
echo "Cleanup complete. Retained last ${RETENTION_COUNT} backups."
