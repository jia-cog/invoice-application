#!/bin/bash
# Database backup script for Invoice Application
# Managed by Ansible - DO NOT EDIT MANUALLY

DB_FILE="{{ database_file }}"
BACKUP_DIR="{{ app_base_dir }}/backups"
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
BACKUP_FILE="${BACKUP_DIR}/invoice_app_${TIMESTAMP}.db"

# Keep only the last 7 backups
MAX_BACKUPS=7

if [ -f "$DB_FILE" ]; then
    cp "$DB_FILE" "$BACKUP_FILE"
    echo "Database backed up to: $BACKUP_FILE"

    # Clean up old backups, keeping only the most recent ones
    cd "$BACKUP_DIR" && ls -t invoice_app_*.db 2>/dev/null | tail -n +$((MAX_BACKUPS + 1)) | xargs -r rm --
    echo "Old backups cleaned up (keeping last $MAX_BACKUPS)"
else
    echo "No database file found at $DB_FILE - skipping backup"
fi
