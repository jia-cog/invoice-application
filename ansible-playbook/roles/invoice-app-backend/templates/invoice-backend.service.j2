# Invoice Application Backend - Systemd Service
# Managed by Ansible - DO NOT EDIT MANUALLY

[Unit]
Description=Invoice Application Backend (Gunicorn)
After=network.target
Wants=network-online.target

[Service]
Type=notify
User={{ app_user }}
Group={{ app_group }}
WorkingDirectory={{ backend_dir }}
EnvironmentFile={{ app_base_dir }}/.secrets/.env
ExecStart={{ backend_venv_dir }}/bin/gunicorn \
    --config {{ backend_dir }}/gunicorn.conf.py \
    "app:create_app()"
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=30
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier={{ app_name }}-backend

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ app_base_dir }}
ReadWritePaths=/var/log/{{ app_name }}

[Install]
WantedBy=multi-user.target
