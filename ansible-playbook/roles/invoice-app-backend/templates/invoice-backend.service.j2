# Invoice Application Backend - systemd service
# Managed by Ansible - Do not edit manually

[Unit]
Description=Invoice Application Backend (Gunicorn)
After=network.target
Wants=network-online.target

[Service]
Type=notify
User={{ app_user }}
Group={{ app_group }}
WorkingDirectory={{ backend_dir }}
EnvironmentFile={{ backend_dir }}/.env

ExecStart={{ backend_venv_dir }}/bin/gunicorn \
    --bind 127.0.0.1:{{ backend_port }} \
    --workers {{ backend_workers }} \
    --timeout 120 \
    --access-logfile /var/log/invoice-app/access.log \
    --error-logfile /var/log/invoice-app/error.log \
    --capture-output \
    wsgi:app

ExecReload=/bin/kill -s HUP $MAINPID

# Restart policy
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=3

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ app_base_dir }}
ReadWritePaths=/var/log/invoice-app

[Install]
WantedBy=multi-user.target
