# Production Configuration Overlay for Invoice Application
# Managed by Ansible - Do not edit manually
#
# This file overrides the default config.py settings for production.
# It is imported by wsgi.py to configure the Flask app.

import os
from datetime import timedelta


class ProductionConfig:
    """Production configuration - overrides defaults from config.py."""

    # Database
    SQLALCHEMY_DATABASE_URI = os.environ.get('DATABASE_URL', '{{ database_url }}')
    SQLALCHEMY_TRACK_MODIFICATIONS = False

    # JWT - use secure, persistent secret
    JWT_SECRET_KEY = os.environ.get('JWT_SECRET_KEY', '{{ jwt_secret_key }}')
    JWT_ACCESS_TOKEN_EXPIRES = timedelta(hours=24)

    # Flask session secret
    SECRET_KEY = os.environ.get('SECRET_KEY', '{{ flask_secret_key }}')

    # CORS - restricted to production frontend domain only
    CORS_ORIGINS = [
{% for origin in cors_allowed_origins %}
        '{{ origin }}',
{% endfor %}
    ]
