# Test image for the backend unittest harness.
# Build from the repository root (requirements.txt lives there):
#   docker build -f src/backend/Dockerfile.test -t invoice-backend-tests:latest .
FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app/src/backend

COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY src/backend/ /app/src/backend/

CMD ["python3", "tests/run_tests.py"]
